# ---------------------------------------------------------------------------
# HAFYN BUILDS — environment variables (placeholders only — never commit a
# real key here). Copy to `.env.local` for local development.
# ---------------------------------------------------------------------------

# Resend — contact/lead email delivery (server-side only).
# Used by POST /api/contact. Real key format: re_xxxxxxxxx
RESEND_API_KEY=

# Sender address. Resend's official test sender by default — it can only
# reach recipients verified on the Resend account. In production, after a
# sending domain is owned and verified in Resend, switch to e.g.
# "HAFYN Leads <lead@hafynbuilds.com>".
RESEND_FROM_EMAIL=HAFYN <onboarding@resend.dev>

# Recipient of lead notifications — the real business inbox. Override per
# environment if a different inbox is needed.
RESEND_TO_EMAIL=hafynbuilds@gmail.com
