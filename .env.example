# ---------------------------------------------------------------------------
# HAFYN BUILDS — environment variables (placeholders only — never commit a
# real key here). Copy to `.env.local` for local development.
# ---------------------------------------------------------------------------

# Resend — contact/lead email delivery (server-side only).
# Used by POST /api/contact. Real key format: re_xxxxxxxxx
RESEND_API_KEY=

# Sender address. Resend's official test sender by default (works with any
# recipient in test mode). In production, after a sending domain is owned
# and verified in Resend, switch to e.g. "HAFYN Leads <lead@hafynbuilds.com>".
RESEND_FROM_EMAIL=HAFYN <onboarding@resend.dev>

# Recipient of lead notifications. Resend's official delivery-test address.
# In production, change to the real inbox, e.g. hafynbuilds@gmail.com.
RESEND_TO_EMAIL=delivered@resend.dev
